[Unit]
Description=Harbor cleaner by kmetrics.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/harbor-clean
EnvironmentFile=/opt/harbor-clean/.env
ExecStart=/bin/bash -lc 'python3 /opt/harbor-clean/get.py && python3 /opt/harbor-clean/clean.py'
